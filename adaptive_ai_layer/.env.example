APP_HOST=127.0.0.1
APP_PORT=8090
LOG_LEVEL=INFO

MYSQL_ENABLED=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=adaptive_ai_user
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=adaptive_ai_layer

MODEL_DIR=./model_artifacts
FINBERT_MODEL_NAME=ProsusAI/finbert
FINBERT_ENABLED=false
FINBERT_BATCH_SIZE=16

REGIME_CONFIDENCE_FLOOR=0.35
HIGH_VOLATILITY_PERCENTILE=0.8
PANIC_RETURN_THRESHOLD=-0.04
LOW_LIQUIDITY_VOLUME_RATIO=0.45
MAX_STRATEGY_WEIGHT=0.35
ANOMALY_ZSCORE_THRESHOLD=3.0

ENABLE_KAFKA=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=adaptive-ai-layer
KAFKA_CONSUMER_GROUP=adaptive-ai-layer
KAFKA_ENABLE_AUTO_COMMIT=false

ENABLE_FEATURE_STORE=true
ENABLE_MODEL_REGISTRY=true
ENABLE_OBSERVABILITY=true
